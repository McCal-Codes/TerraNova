#!/bin/sh
# Reject commits unless author and committer are McCal <business@mcc-cal.com>.
# Blocks common agent/copilot identities.

ALLOWED_NAME="McCal"
ALLOWED_EMAIL="business@mcc-cal.com"

author=$(git var GIT_AUTHOR_IDENT 2>/dev/null || true)
committer=$(git var GIT_COMMITTER_IDENT 2>/dev/null || true)

blocked_pattern='cursor|cursoragent|copilot|openai|anthropic|agent|noreply\.github\.com|dependabot|github-actions'

check_ident() {
  role=$1
  ident=$2
  if [ -z "$ident" ]; then
    echo "commit-msg hook: missing $role identity" >&2
    exit 1
  fi
  echo "$ident" | grep -Eiq "$blocked_pattern" && {
    echo "commit-msg hook: $role looks like an automated identity: $ident" >&2
    exit 1
  }
  name=$(echo "$ident" | sed 's/ <.*//')
  email=$(echo "$ident" | sed -n 's/.*<\([^>]*\)>.*/\1/p')
  if [ "$email" != "$ALLOWED_EMAIL" ]; then
    echo "commit-msg hook: $role email must be $ALLOWED_EMAIL (got: $email)" >&2
    exit 1
  fi
  if [ "$(echo "$name" | tr '[:upper:]' '[:lower:]')" != "$(echo "$ALLOWED_NAME" | tr '[:upper:]' '[:lower:]')" ]; then
    echo "commit-msg hook: $role name must be $ALLOWED_NAME (got: $name)" >&2
    exit 1
  fi
}

check_ident "author" "$author"
check_ident "committer" "$committer"

# Reject agent co-author trailers (prepare-commit-msg strips these; block if any remain).
if grep -Eiq "^[Cc]o-[Aa]uthored-[Bb]y:.*($blocked_pattern)" "$1" 2>/dev/null; then
  echo "commit-msg hook: remove agent Co-authored-by lines from the commit message" >&2
  exit 1
fi

exit 0

#!/bin/sh
# Reject commits unless author/committer match McCal-Codes GitHub identity.

ALLOWED_NAMES="McCal-Codes McCal"
ALLOWED_EMAILS="business@mcc-cal.com 175259256+McCal-Codes@users.noreply.github.com McCal-Codes@users.noreply.github.com"

author=$(git var GIT_AUTHOR_IDENT 2>/dev/null || true)
committer=$(git var GIT_COMMITTER_IDENT 2>/dev/null || true)

name_ok() {
  n=$(echo "$1" | tr '[:upper:]' '[:lower:]')
  for allowed in $ALLOWED_NAMES; do
    if [ "$n" = "$(echo "$allowed" | tr '[:upper:]' '[:lower:]')" ]; then
      return 0
    fi
  done
  return 1
}

email_ok() {
  e=$1
  for allowed in $ALLOWED_EMAILS; do
    if [ "$e" = "$allowed" ]; then
      return 0
    fi
  done
  return 1
}

check_ident() {
  role=$1
  ident=$2
  if [ -z "$ident" ]; then
    echo "commit-msg hook: missing $role identity" >&2
    exit 1
  fi
  name=$(echo "$ident" | sed 's/ <.*//')
  email=$(echo "$ident" | sed -n 's/.*<\([^>]*\)>.*/\1/p')
  if ! email_ok "$email"; then
    echo "commit-msg hook: $role email must be a McCal-Codes GitHub email (got: $email)" >&2
    exit 1
  fi
  if ! name_ok "$name"; then
    echo "commit-msg hook: $role name must be McCal-Codes (got: $name)" >&2
    exit 1
  fi
}

check_ident "author" "$author"
check_ident "committer" "$committer"

if grep -Eiq "^[Cc]o-[Aa]uthored-[Bb]y:" "$1" 2>/dev/null; then
  echo "commit-msg hook: remove Co-authored-by lines (McCal-Codes-only commits)" >&2
  exit 1
fi

exit 0
